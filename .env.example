# Copy this file to .env and fill it in. Never share .env or put it on GitHub.

# Bot token from https://discord.com/developers/applications -> your app -> Bot -> Reset Token
DISCORD_TOKEN=paste-your-bot-token-here

# Not needed anymore: slash commands load in every server the bot is in.
GUILD_ID=

# Channel for rare-find announcements (you can also set it in Discord with /admin announce)
ANNOUNCE_CHANNEL_ID=

# Your Discord user ID, so you can use /admin commands. Comma-separate for more people.
ADMIN_USER_IDS=

# Who gets error reports by DM (comma separated user IDs). Leave empty to DM whoever owns the bot application.
ERROR_DM_USER_IDS=

# Webhook for the update channel (channel settings -> Integrations -> Webhooks -> New Webhook -> Copy URL)
UPDATE_WEBHOOK_URL=
# Optional: who to ping with updates, like @everyone or <@&ROLE_ID>
UPDATE_PING=

# Backups (automatic). Defaults: the backups folder next to the bot, every 30 minutes.
# Pointing BACKUP_DIR at a OneDrive/Google Drive folder gives you a copy off this PC too.
BACKUP_DIR=
BACKUP_EVERY_MINUTES=30

# The bot restarts itself when new update files land in its folder. Set to off to only restart with /admin restart.
AUTO_RESTART=on
