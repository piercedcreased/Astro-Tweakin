# Copy this file to .env and fill it in. Never share .env or put it on GitHub.

# Bot token from https://discord.com/developers/applications -> your app -> Bot -> Reset Token
DISCORD_TOKEN=paste-your-bot-token-here

# Your server's ID (right-click the server icon -> Copy Server ID). Makes slash commands show up instantly.
GUILD_ID=

# Channel for rare-find announcements (you can also set it in Discord with /admin announce)
ANNOUNCE_CHANNEL_ID=

# Your Discord user ID, so you can use /admin commands. Comma-separate for more people.
ADMIN_USER_IDS=

# Webhook for the update channel (channel settings -> Integrations -> Webhooks -> New Webhook -> Copy URL)
UPDATE_WEBHOOK_URL=
# Optional: who to ping with updates, like @everyone or <@&ROLE_ID>
UPDATE_PING=
